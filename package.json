{
  "name": "lab-handover-notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lab 008: handover notes kept as dated, versioned Markdown that a client asks questions of, on a web page or over MCP.",
  "imports": {
    "#capabilities": "./capabilities/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "db:local": "wrangler d1 execute handover-notes --local --config wrangler.toml --file schema.sql",
    "db:remote": "wrangler d1 execute handover-notes --remote --config wrangler.toml --file schema.sql",
    "invite": "node scripts/invite.mjs",
    "deploy": "wrangler deploy --config wrangler.toml",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "test:watch": "vitest",
    "off": "node scripts/switch.mjs off",
    "on": "node scripts/switch.mjs on"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261025.1",
    "@types/node": "24.13.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "$zod",
    "sharp": "0.35.5",
    "wrangler": "$wrangler"
  }
}
